# ─────────────────────────────────────────────────────────────
# FADIYE — variables d'environnement
# Copier en `.env.local` pour le développement local, et les
# renseigner dans Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# URL publique du site (SEO, sitemap, Open Graph). Sur Vercel, l'URL
# de production est détectée automatiquement si cette variable est vide.
NEXT_PUBLIC_SITE_URL=

# Adresse e-mail de contact affichée sur le site.
NEXT_PUBLIC_CONTACT_EMAIL=

# Lien complet du compte Instagram (ex. https://www.instagram.com/...).
NEXT_PUBLIC_INSTAGRAM_URL=

# Paiement Stripe (clé SECRÈTE, côté serveur uniquement — jamais NEXT_PUBLIC_).
# Tant qu'elle est vide, le paiement est affiché comme « non activé ».
# Utiliser une clé de test (sk_test_...) avant la mise en production.
STRIPE_SECRET_KEY=
